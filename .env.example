# Copy this file to .env, then run: composer install && npm ci && php artisan key:generate
APP_NAME=
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Set this to the pharmacy's local timezone. Without it, "due today" reminders
# and till-day cut-offs are calculated on UTC.
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pmas
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# First administrator created by the seeders. Staff sign in with a username,
# so ADMIN_USERNAME is what you type at the login screen; the email is kept on
# the account for your records. Change the password after the first login. In
# production leave ADMIN_PASSWORD blank and the seeder will generate a strong
# one and print it once.
ADMIN_NAME=Admin User
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@pmas.com
ADMIN_PASSWORD=

# Nightly database backups (php artisan pmas:backup): how many files to keep.
BACKUP_KEEP=14

# Vendor credit shown in the app chrome ("by ..." on the login page and
# "Powered by ..." on every page).
VENDOR_NAME="AMBA Solutions"
VENDOR_URL=https://amba.site.je

# Only needed behind a reverse proxy / load balancer (comma-separated IPs, or
# "*" to trust all). Leave blank when PHP serves requests directly.
TRUSTED_PROXIES=
